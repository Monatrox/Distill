<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Monatrox</Authors>
    <RepositoryUrl>https://github.com/Monatrox/distill</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable Condition="'$(MSBuildProjectName)' == 'Distill.Client.ContractTests'">false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Distill.Extensions.Logging'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
