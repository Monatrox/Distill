RABBITMQ_URI=amqp://guest:guest@127.0.0.1:5672/%2f
DISTILL_INGEST_API_KEY=replace-me-ingest
DISTILL_ADMIN_API_KEY=replace-me-admin
DISTILL_BIND_ADDRESS=127.0.0.1:8080
# Administrative routes are intentionally loopback-only.
DISTILL_ADMIN_BIND_ADDRESS=127.0.0.1:8081
# HTTP resource controls. Set any value to 0 to disable that control.
DISTILL_REQUEST_BODY_LIMIT_BYTES=2097152
DISTILL_REQUEST_TIMEOUT_SECONDS=30
DISTILL_MAX_CONCURRENT_REQUESTS=128
DISTILL_MAX_REQUESTS_PER_MINUTE=6000
# Public hostname used by the Compose Caddy proxy. Use a real DNS name for an ACME certificate.
DISTILL_PUBLIC_HOST=localhost
# Optional default sink for simplified POST /channels requests.
# DISTILL_DEFAULT_SINK_CONNECTION_STRING=postgresql://user:password@127.0.0.1:5432/logs
# Optional prefix for generated RabbitMQ exchanges.
# DISTILL_EXCHANGE_NAME_PREFIX=distill
